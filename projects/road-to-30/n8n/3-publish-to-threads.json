      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// One item per approved post, with its text ready for Threads\nconst out = [];\nfor (const r of ($input.first().json.results || [])) {\n  const text = (r.properties['Text']?.rich_text || []).map(t => t.plain_text).join('').trim();\n  if (text) out.push({ json: { pageId: r.id, text: text.slice(0, 500) } });\n}\nreturn out;\n"
      },
      "id": "f3ecbc56-d009-4ece-92bd-cb6af563cf03",
      "name": "One item per post",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        300
      ]
    },
