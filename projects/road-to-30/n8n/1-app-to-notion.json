    {
      "parameters": {
        "jsCode": "// Turn the Notion goals into the app's goal format\nconst out = [];\nfor (const item of $input.all()) {\n  for (const p of (item.json.results || [])) {\n    const pr = p.properties || {};\n    const plain = x => (x?.rich_text || x?.title || []).map(t => t.plain_text).join('');\n    const appId = plain(pr['App ID']) || p.id.replace(/-/g, '');\n    const steps = plain(pr['Steps']).split('\\n').map(s => s.trim()).filter(Boolean).map((s, i) => ({\n      id: appId + '-' + i,\n      text: s.replace(/^[☐☑☒]\\s*/, ''),\n      done: s.startsWith('☑') || s.startsWith('☒'),\n    }));\n    out.push({\n      id: appId,\n      title: plain(pr['Goal']),\n      area: pr['Area']?.select?.name || 'Learning',\n      due: pr['Target date']?.date?.start?.slice(0, 10) || '',\n      hours: pr['Hours target']?.number || 0,\n      subjectName: plain(pr['Linked subject']),\n      steps,\n    });\n  }\n}\nreturn [{ json: { ok: true, goals: out } }];\n"
      },
