    {
      "parameters": {
        "jsCode": "// Study Focus -> Notion. Checks the key, then turns the app event into Notion properties.\nconst SECRET = 'CHANGE-ME-to-a-long-random-key'; // must match the key in the app's Notion sync settings\nconst SESSIONS_DB = '41c735e40e2581deacfbe66f8f77766f';\nconst GOALS_DB = '41c735e40e258189aa40dae4f51c9fcc';\nconst POSTS_DB = '41c735e40e258186845fd5323669362c';\n\nlet b = $json.body;\nif (typeof b === 'string') { try { b = JSON.parse(b); } catch (e) { b = {}; } }\nb = b || {};\nif (!SECRET || SECRET.startsWith('CHANGE-ME') || b.key !== SECRET) throw new Error('Invalid key');\n\nconst txt = (s, max = 1900) => [{ text: { content: String(s ?? '').slice(0, max) } }];\nconst sel = s => s ? { select: { name: String(s).replace(/,/g, ' ').slice(0, 100) } } : { select: null };\nconst num = n => ({ number: (n === '' || n == null || isNaN(+n)) ? null : +n });\nconst d = b.data || {};\n\nif (b.type === 'ping') return [{ json: { route: 'done', ok: true, message: 'n8n is connected' } }];\nif (b.type === 'pull_goals') return [{ json: { route: 'pull', db: GOALS_DB } }];\n\nif (b.type === 'session' || b.type === 'session_delete') {\n  const properties = {\n    'Working on': { title: txt(d.task || d.subject || 'Study session', 200) },\n    'Date': { date: { start: d.startLocal } },\n    'Minutes': num(d.min),\n    'Subject': sel(d.subject),\n    'Focus rating': num(d.rating || null),\n    'Distractions': num(d.kind === 'timer' ? d.distractions : null),\n    'Notes': { rich_text: txt(d.note) },\n    'Source': sel(d.kind),\n    'App ID': { rich_text: txt(d.id) },\n  };\n  return [{ json: { route: 'write', db: SESSIONS_DB, appId: String(d.id), archive: b.type === 'session_delete', properties, draft: null } }];\n}\n\nif (b.type === 'goal' || b.type === 'goal_delete') {\n  const steps = Array.isArray(d.steps) ? d.steps : [];\n  const done = steps.filter(s => s.done).length;\n  const status = steps.length && done === steps.length ? 'Done' : (done > 0 ? 'In progress' : 'Not started');\n  const properties = {\n    'Goal': { title: txt(d.title || 'Goal', 200) },\n    'Area': sel(d.area),\n    'Target date': { date: d.due ? { start: d.due } : null },\n    'Steps done': num(done),\n    'Steps total': num(steps.length),\n    'Status': sel(status),\n    'Steps': { rich_text: txt(steps.map(s => (s.done ? '☑ ' : '☐ ') + s.text).join('\\n')) },\n    'Linked subject': { rich_text: txt(d.subject || '') },\n    'Hours target': num(d.hours || null),\n    'App ID': { rich_text: txt(d.id) },\n  };\n  // A milestone draft for Threads when a step was just ticked (you approve it in Notion before it is posted)\n  let draft = null;\n  const newly = Array.isArray(d.newlyDone) ? d.newlyDone : [];\n  if (b.type === 'goal' && newly.length) {\n    const finished = status === 'Done';\n    const text = finished\n      ? `Goal complete: ${d.title} ✅\\n\\nOne more thing done on my Road to 30.\\n\\n#RoadTo30`\n      : `Small win on my Road to 30: ${newly.join(', ')} ✔️\\n\\n${d.title} · ${done}/${steps.length} steps done.\\n\\n#RoadTo30`;\n    draft = {\n      parent: { database_id: POSTS_DB },\n      properties: {\n        'Post': { title: txt((finished ? 'Goal complete: ' : 'Step done: ') + d.title, 200) },\n        'Text': { rich_text: txt(text, 500) },\n        'Status': { select: { name: 'Draft' } },\n        'Type': { select: { name: 'Milestone' } },\n      },\n    };\n  }\n  return [{ json: { route: 'write', db: GOALS_DB, appId: String(d.id), archive: b.type === 'goal_delete', properties, draft } }];\n}\n\nthrow new Error('Unknown event type: ' + b.type);\n"
      },
